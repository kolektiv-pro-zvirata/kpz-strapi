{
  "kind": "collectionType",
  "collectionName": "topics",
  "info": {
    "singularName": "topic",
    "pluralName": "topics",
    "displayName": "Topic",
    "description": "A main lesson topic (e.g. Rostlinná mléka, Tempeh) grouping several experiences"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "content": {
      "type": "blocks"
    },
    "order": {
      "type": "integer"
    },
    "mainCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::main-category.main-category",
      "inversedBy": "topics"
    },
    "experiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experience.experience",
      "inversedBy": "topics"
    }
  }
}
