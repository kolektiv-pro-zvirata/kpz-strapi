{
  "kind": "collectionType",
  "collectionName": "experiences",
  "info": {
    "singularName": "experience",
    "pluralName": "experiences",
    "displayName": "Experience",
    "description": "A single lesson item (recipe, video, quiz or task) belonging to one or more topics"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "content": {
      "type": "blocks"
    },
    "points": {
      "type": "integer",
      "min": 0
    },
    "video": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Video"
          ]
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos",
        "files"
      ]
    },
    "quiz": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Quiz"
          ]
        }
      },
      "component": "quiz.question",
      "repeatable": true
    },
    "typeOfExperience": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Recipe",
        "Video",
        "Quiz",
        "Task"
      ]
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "mappedBy": "experiences"
    },
    "prepTime": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Recipe"
          ]
        }
      },
      "enum": [
        "Max30Min",
        "Max1Hour",
        "Over1Hour"
      ]
    },
    "course": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Recipe"
          ]
        }
      },
      "enum": [
        "Breakfast",
        "Lunch",
        "Dinner"
      ]
    },
    "servings": {
      "type": "integer",
      "min": 1,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Recipe"
          ]
        }
      }
    },
    "nutrition": {
      "type": "component",
      "component": "recipe.nutrition",
      "repeatable": false,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfExperience"
            },
            "Recipe"
          ]
        }
      }
    }
  }
}
