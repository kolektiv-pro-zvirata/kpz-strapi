      "required": true,
      "min": 0
    },
    "fatG": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "carbsG": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "fiberG": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "recipe.nutrient-section"
    }
  }
