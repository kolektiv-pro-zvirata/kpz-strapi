{
  "collectionName": "components_level_rewards",
  "info": {
    "displayName": "Reward",
    "description": "What the user unlocks at this level. Which fields show up depends on typeOfReward, the same conditional pattern as Experience's typeOfExperience."
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "typeOfReward": {
      "type": "enumeration",
      "enum": [
        "Video",
        "Image"
      ],
      "default": "Video",
      "required": true
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos",
        "files"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfReward"
            },
            "Video"
          ]
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "typeOfReward"
            },
            "Image"
          ]
        }
      }
    }
  }
}
