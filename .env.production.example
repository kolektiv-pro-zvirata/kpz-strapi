# Production environment for the Roští.cz Docker Stack.
# Copy this to `.env` in the stack (the Compose editor reads ${VARS} from it).
#
# Generate EVERY secret fresh — never reuse the local dev values from .env.
# Handy generators:
#   APP_KEYS (need 2+):  node -e "console.log(Array.from({length:4},()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
#   single secret:       node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# Image you pushed to the registry (rosticli / GHCR), e.g.
#   ghcr.io/notum/kpz-strapi:latest
STRAPI_IMAGE=

# Public HTTPS URL of the stack. Set the domain in the Proxy tab first; until
# you have a custom domain, Roští gives you one like https://strapi-1234.rostiapp.cz
PUBLIC_URL=https://strapi-xxxx.rostiapp.cz

# --- Strapi secrets (generate all fresh) ---
APP_KEYS=changeMe1,changeMe2
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# --- PostgreSQL ---
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeMe
